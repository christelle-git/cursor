# ===========================================================================
# MotionForge — configuration
# Copiez ce fichier en `.env` puis renseignez vos valeurs.
# ===========================================================================

# Fournisseur de génération par défaut : "local" (aucune clé requise, hors-ligne)
# ou "replicate" (génération IA vidéo-à-vidéo, nécessite un token).
MF_DEFAULT_PROVIDER=local

# --- Replicate (optionnel, pour la vraie génération IA vidéo-à-vidéo) ---
# Obtenez un token sur https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Modèle vidéo-à-vidéo Replicate à utiliser (format "owner/name" ou "owner/name:version").
# Exemple par défaut : un modèle de restyling vidéo guidé par prompt.
MF_REPLICATE_MODEL=fofr/video-to-video

# --- Limites & stockage ---
# Taille maximale d'upload (Mo)
MF_MAX_UPLOAD_MB=200
# Répertoire de stockage (uploads + rendus)
MF_STORAGE_DIR=storage
