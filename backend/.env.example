# Copier ce fichier en ".env" pour configurer l'API en local.

# "mock" (par défaut) : traitement local via ffmpeg, aucune clé requise.
# "replicate" : génération vidéo-à-vidéo par IA via l'API Replicate.
VIDEO_PROVIDER=mock

# Requis uniquement si VIDEO_PROVIDER=replicate.
# Créer un jeton sur https://replicate.com/account/api-tokens
# Ne jamais committer de vraie valeur : utiliser les secrets Cursor Dashboard.
REPLICATE_API_TOKEN=

# Modèle Replicate à utiliser pour la génération vidéo-à-vidéo.
REPLICATE_MODEL=luma/modify-video
